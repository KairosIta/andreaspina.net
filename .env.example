# Copiare in `.env.local` (sviluppo) e compilare.
# `.env*` e' in .gitignore: i valori veri non finiscono mai nel repository.

# --- Sito ---
# Indirizzo pubblico di questa istanza. Solo se vale esattamente
# "https://andreaspina.net" il sito si lascia indicizzare: staging e sviluppo
# rispondono con robots.txt Disallow e header X-Robots-Tag: noindex.
SITE_URL="http://localhost:3000"

# --- Database (deve combaciare con docker-compose.yml) ---
POSTGRES_USER="andreaspina"
POSTGRES_PASSWORD="dev_only_password"
POSTGRES_DB="andreaspina"
DATABASE_URL="postgres://andreaspina:dev_only_password@localhost:5432/andreaspina"

# --- AI (Fase 3) ---
# Chiave OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
